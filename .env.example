DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ALLOWED_ORIGINS=

# Cloudflare R2: вложения к урокам. Свой бакет для разработки —
# seed_demo --flush чистит его целиком.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Дверь для разработки: вход любым посеянным аккаунтом без Google
# (переключатель «войти как» в меню пользователя). Гугл-аккаунтов на класс
# учеников не напасёшься, а плюс-адреса не годятся: под алиасом в Google не
# войти. В .env.prod этой строки нет и быть не должно.
E2E_TEST_LOGIN=true


ANTHROPIC_API_KEY=
