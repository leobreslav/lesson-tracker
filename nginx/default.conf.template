# ВНИМАНИЕ: это шаблон, а не готовый конфиг. Официальный образ nginx
# прогоняет /etc/nginx/templates/*.template через envsubst при старте и
# кладёт результат в /etc/nginx/conf.d/.
#
# Подставляются ТОЛЬКО DOMAIN и DOMAIN_ALIASES — имена тут
# написаны без знака доллара намеренно:
# со знаком envsubst подставил бы их и в этот комментарий, и в
# отрисованном конфиге он перестал бы что-либо объяснять. Список задан
# переменной NGINX_ENVSUBST_FILTER в compose. Без неё envsubst подставил бы
# всё подряд — и $host, $uri, $backend_addr превратились бы в пустые строки,
# то есть конфиг сломался бы молча, а не с ошибкой.

# встроенный DNS docker'а. Короткий TTL: после пересоздания backend nginx
# должен быстро увидеть новый IP.
resolver 127.0.0.11 valid=10s ipv6=off;

# Vite собирает воркеры отдельными `.mjs`, а mime.types про это расширение не
# знает и отдаёт octet-stream. Браузер такой файл как модуль не берёт —
# «Strict MIME type checking» — и лениво подгружаемый модуль молча не
# запускается: в сборке ошибки нет, потому что код не выполняется.
types {
    application/javascript mjs;
}

server {
    # default_server — чтобы конфиг отвечал и на http://localhost при
    # локальной проверке, а не только на боевые имена
    listen 80 default_server;
    server_name ${DOMAIN} ${DOMAIN_ALIASES};

    client_max_body_size 25m;

    # адрес в переменной, а не в блоке upstream: имя в upstream резолвится
    # один раз при старте, и после пересоздания backend nginx продолжает
    # ходить на старый IP, отдавая 502
    set $backend_addr backend:8000;

    # проверка владения доменом для certbot --webroot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # собранный React
    location / {
        root /var/www/frontend;
        try_files $uri /index.html;
    }

    # Куски бандла — только сами файлы, без фолбэка на index.html.
    #
    # Имена у них с хэшем содержимого, и после выкатки прежних имён на
    # сервере нет. С общим фолбэком nginx отдавал на такой запрос
    # index.html: браузер получал HTML вместо модуля, отказывался его
    # исполнять («Strict MIME type checking») и ронял ленивый импорт —
    # вкладка, открытая до выкатки, показывала экран «страница не
    # отрисовалась». Честный 404 читается однозначно и клиентом, и логом,
    # а чинит вкладку перезагрузка (frontend/src/lazyChunk.js).
    #
    # Раз имя несёт хэш, содержимое по нему не меняется никогда — поэтому
    # immutable на год.
    location /assets/ {
        root /var/www/frontend;
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # А сам index.html кэшировать нельзя: он и есть список актуальных имён
    # кусков. Закэшированный, он после выкатки продолжал бы звать старые —
    # ту же поломку, только уже без стареющей вкладки.
    location = /index.html {
        root /var/www/frontend;
        add_header Cache-Control "no-cache";
    }

    # статика Django: админка и DRF
    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires 30d;
    }

    # Пароля на контуре нет ни у одного адреса, и вернуть его сюда нельзя:
    # basic-auth и токен приложения делят заголовок Authorization, а
    # приложение ставит `Authorization: Token …` на каждый запрос — явный
    # заголовок вытесняет basic-auth, и весь API отвечал бы 401 от nginx.
    # Дверь, которую нельзя поставить там, где входят, закрывает не то;
    # закрывает вход список допущенных адресов (backend/accounts/door.py).
    location /api/ {
        proxy_pass http://$backend_addr;
        include /etc/nginx/proxy_params.conf;
    }

    location /admin/ {
        proxy_pass http://$backend_addr;
        include /etc/nginx/proxy_params.conf;
    }
}
