__pycache__/
*.py[cod]
.env
.env.prod
# резервные копии, которые push-deploy.sh оставляет на сервере рядом с ним:
# без этой строки deploy.sh считал бы рабочее дерево грязным
.env.prod.bak.*
staticfiles/
media/
node_modules/
dist/
.idea/
# следы браузерных прогонов: снимки и трассы пишет контейнер, и они
# root'овы — `git add -A` утаскивал их в коммит вместе с работой
e2e/test-results/
e2e/tmp-*.png
# следы компиляции бланка: pdflatex пишет их рядом с исходником, а в репозиторий
# едут только сам .tex и собранный .pdf
blank/*.aux
blank/*.log
blank/*.synctex.gz
blank/preview*.png
