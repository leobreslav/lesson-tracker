# Боевое окружение. Скопировать и заполнить — но не рядом с этим файлом:
# главная копия лежит на ноутбуке вне репозитория, по умолчанию в
# ~/secrets/lesson-tracker.env.prod, и оттуда её везёт push-deploy.sh.
# На сервере файл руками не редактируют, см. DEPLOY.md, раздел 2.

# Имя контура. Им разведены прод и стенд на разных машинах, и им же
# compose называет проект: контуры на одной машине не переиспользуют
# чужие контейнеры и тома. Пусто — остаётся lesson-tracker-prod.
COMPOSE_PROJECT_NAME=lesson-tracker-prod

# Домен контура. Отсюда его берёт шаблон nginx: и server_name, и путь к
# сертификату (/etc/letsencrypt/live/<DOMAIN>/). Обязателен — deploy.sh
# без него отказывается работать, не тронув ни git, ни контейнеры.
DOMAIN=lbreslav.com
# Остальные имена того же сервера, через пробел. Пусто — их нет.
# Сертификат должен покрывать и их тоже.
DOMAIN_ALIASES=www.lbreslav.com

DEBUG=False
# длинная случайная строка, отличная от dev-ключа:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=lbreslav.com,www.lbreslav.com

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Первый суперпользователь. Его заводит `manage.py bootstrap` при старте
# контейнера, но только если суперпользователей нет вообще — сменить пароль
# существующему через эти переменные нельзя. Если адрес уже принадлежит
# обычному аккаунту (например, человек успел войти через Google), аккаунт
# повышается до суперпользователя, а не дублируется.
# Обе пустые — шаг пропускается с предупреждением, контейнер стартует.
BOOTSTRAP_SUPERUSER_EMAIL=
BOOTSTRAP_SUPERUSER_PASSWORD=

# Дверь для браузерных тестов: токен по email и сброс базы. В проде её быть
# не должно — при выключенном флаге маршруты вообще не регистрируются.
# Оставьте строку закомментированной.
# E2E_TEST_LOGIN=true

# Кого этот контур пускает внутрь — список адресов через запятую.
#
# Пусто значит «всех, кого пустил Google», и так живёт прод: допуск там даёт
# приглашение школы, а список пришлось бы править при каждом новом учителе.
# Список нужен контуру, у которого своей публики нет вовсе, — стенду.
#
# Действует он на обе двери сразу: и на вход через Google, и на дев-дверь
# выше. Поэтому пара «дев-дверь включена, список пуст» запрещена — выкатка
# на ней отказывает, см. scripts/check-login-door.sh.
# LOGIN_ALLOWED_EMAILS=вы@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# тот же client_id — Vite вшивает его в бандл при сборке
VITE_GOOGLE_CLIENT_ID=

# фронтенд и API на одном origin, поэтому список нужен только если
# появится отдельный поддомен для API
CORS_ALLOWED_ORIGINS=https://lbreslav.com,https://www.lbreslav.com

# схема обязательна, иначе Django отвергает POST из админки
CSRF_TRUSTED_ORIGINS=https://lbreslav.com,https://www.lbreslav.com

# включить после выпуска сертификатов; до этого оставить False,
# иначе nginx без TLS уйдёт в бесконечный редирект
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# включать в последнюю очередь: браузеры запоминают заголовок надолго
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# подключить nginx/ssl.conf.template вместо nginx/default.conf.template.
# Ставить true только после того, как certbot выпустил сертификат:
# без него nginx не стартует. Этот флаг читает deploy.sh.
NGINX_SSL=false

# Cloudflare R2: файлы, приложенные к урокам. Бакет приватный, наружу
# ничего не отдаёт: приложение подписывает ссылку на пять минут.
# Бакет обязательно отдельный от dev — seed_demo вычищает свой.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Резервный бакет: в него scripts/backup-files.sh копирует новые объекты
# раз в сутки. Versioning в R2 не существует (это функция AWS S3), поэтому
# копия делается вторым бакетом. Endpoint тот же, что выше.
# Токен нужен с правами Object Read & Write на ОБА бакета: копирование идёт
# внутри Cloudflare, одним клиентом. Приложение этих ключей не касается.
R2_BACKUP_BUCKET_NAME=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=


# Лимиты файлов. Пусто — значения по умолчанию: 20 МБ на файл,
# 5 ГБ на школу, ссылка живёт 300 секунд.
# nginx пропускает 25m (client_max_body_size), так что поднимать
# FILE_MAX_BYTES выше ~24 МБ без правки конфига бессмысленно.
FILE_MAX_BYTES=
SCHOOL_FILE_QUOTA_BYTES=
FILE_URL_TTL=


ANTHROPIC_API_KEY=

